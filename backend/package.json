{
  "name": "cryo-erp-backend",
  "version": "1.0.0",
  "description": "Production-grade MERN ERP Backend for Cryo Scientific Systems Pvt Ltd",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeders/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:e2e": "jest tests/e2eWorkflow.test.js --runInBand --detectOpenHandles --forceExit"
  },
  "keywords": [
    "erp",
    "cryo",
    "manufacturing",
    "express",
    "mongodb",
    "mongoose"
  ],
  "author": "Cryo Engineering Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "morgan": "^1.10.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
