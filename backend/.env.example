# Server Configuration
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/cryo_erp_db

# Security & JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production_min32chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# File Storage Configuration (local or s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email / SMTP Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@cryoscientific.com

# Tally ERP Adapter Configuration
TALLY_BASE_URL=http://localhost:9000
TALLY_API_KEY=
TALLY_COMPANY_NAME=Cryo Scientific Systems Pvt Ltd
